const express = require('express');
const app = express();

// 1. آپ کی اپنی بنائی ہوئی سیکرٹ API Key
const MY_OWN_API_KEY = "Umar_Video_Auth_9988"; 

app.use(express.json());

// 2. وہ راستہ جہاں ڈیٹا آئے گا
app.post('/make-video', (req, res) => {
    
    // یوزر کے ہیڈر سے کی (Key) نکالنا
    const providedKey = req.headers['x-api-key'];

    // 3. لاجک: کیا کی میچ کرتی ہے؟
    if (providedKey === MY_OWN_API_KEY) {
        
        // اگر کی ٹھیک ہے
        const videoText = req.body.text; 
        console.log("کمپیوٹر ویڈیو بنا رہا ہے: " + videoText);

        res.status(200).json({
            success: true,
            message: "درست API Key! ویڈیو پروسیسنگ شروع کر دی گئی ہے۔",
            brand: "Zenith Tech Matrix"
        });

    } else {
        // اگر کی غلط ہے تو 403 Forbidden ایرر
        res.status(403).json({
            success: false,
            message: "غلط API Key! آپ کو رسائی کی اجازت نہیں ہے۔"
        });
    }
});

// ہوم پیج کے لیے سادہ راستہ
app.get('/', (req, res) => {
    res.send("Zenith Tech Matrix API System is Running...");
});

app.listen(3000, () => console.log("آپ کا سسٹم پورٹ 3000 پر ایکٹو ہے"));
