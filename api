const express = require('express');
const app = express();

// 1. آپ کی اپنی بنائی ہوئی سیکرٹ API Key
const MY_OWN_API_KEY = "Umar_Video_Auth_9988"; 

app.use(express.json());

// 2. ہوم روٹ (چیک کرنے کے لیے کہ سرور چل رہا ہے یا نہیں)
app.get('/', (req, res) => {
    res.status(200).json({
        success: true,
        message: "Zenith Tech Matrix API System is Live",
        status: "Active"
    });
});

// 3. ویڈیو جنریشن اینڈ پوائنٹ (جہاں Antigravity ڈیٹا بھیجے گا)
app.post('/make-video', (req, res) => {
    
    // ہیڈرز سے API Key حاصل کرنا
    const providedKey = req.headers['x-api-key'];

    // سیکورٹی چیک: کیا کی درست ہے؟
    if (providedKey === MY_OWN_API_KEY) {
        
        // یوزر کا بھیجا ہوا ٹیکسٹ حاصل کرنا
        const videoText = req.body.text || "Default Text"; 
        
        console.log("Processing Video for Zenith Tech Matrix: " + videoText);

        // یہاں وہ لاجک آئے گا جو ویڈیو رینڈر کرے گا
        // فی الحال یہ ایک کامیابی کا پیغام بھیج رہا ہے
        res.status(200).json({
            success: true,
            message: "درست API Key! ویڈیو پروسیسنگ شروع کر دی گئی ہے۔",
            data: {
                text_received: videoText,
                aspect_ratio: "16:9", // آپ کی پسندیدہ ریشو
                theme: "Dark Modern", // آپ کا ڈیزائن تھیم
                brand: "Zenith Tech Matrix"
            }
        });

    } else {
        // اگر کی غلط ہو تو رسائی روک دیں
        res.status(403).json({
            success: false,
            message: "غلط API Key! آپ کو رسائی کی اجازت نہیں ہے۔"
        });
    }
});

// سرور کو پورٹ 3000 پر چلانا
const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
    console.log(`سرور پورٹ ${PORT} پر تیار ہے...`);
});
